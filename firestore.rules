rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ianitalocorp@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasValidAccessRequest() {
      let accessRequest = request.resource.data;
      return accessRequest.keys().hasAll(['email', 'status', 'requestedAt'])
        && accessRequest.keys().hasOnly(['email', 'status', 'requestedAt'])
        && accessRequest.email is string
        && accessRequest.email.size() <= 254
        && accessRequest.email == request.auth.token.email
        && accessRequest.status == 'pending'
        && accessRequest.requestedAt == request.time;
    }

    function isValidPromoApplication() {
      let accessRequest = request.resource.data;
      return resource.data.status == 'pending'
        && accessRequest.keys().hasAll(['email', 'status', 'requestedAt', 'promoCode', 'amount'])
        && accessRequest.keys().hasOnly(['email', 'status', 'requestedAt', 'promoCode', 'amount'])
        && accessRequest.status == 'pending'
        && accessRequest.promoCode in ['SEREI APROVADO', 'SEREI APROVADA']
        && accessRequest.amount == 74.9
        && accessRequest.diff(resource.data).affectedKeys().hasOnly(['promoCode', 'amount']);
    }

    function isValidAdminReview() {
      let accessRequest = request.resource.data;
      return resource.data.status == 'pending'
        && accessRequest.keys().hasAll(['email', 'status', 'requestedAt', 'reviewedAt'])
        && accessRequest.keys().hasOnly(['email', 'status', 'requestedAt', 'reviewedAt', 'promoCode', 'amount'])
        && accessRequest.status in ['approved', 'rejected']
        && accessRequest.reviewedAt == request.time
        && accessRequest.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
    }

    function isValidResubmission() {
      let accessRequest = request.resource.data;
      return resource.data.status == 'rejected'
        && accessRequest.keys().hasAll(['email', 'status', 'requestedAt'])
        && accessRequest.keys().hasOnly(['email', 'status', 'requestedAt', 'promoCode', 'amount'])
        && accessRequest.email == request.auth.token.email
        && accessRequest.status == 'pending'
        && accessRequest.requestedAt == request.time
        && accessRequest.diff(resource.data).affectedKeys().hasOnly(['status', 'requestedAt', 'reviewedAt']);
    }

    function hasValidStudyPreferences(profile) {
      let preferences = profile.studyPreferences;
      return preferences is map
        && preferences.keys().hasAll(['mode', 'days', 'startTime', 'endTime'])
        && preferences.keys().hasOnly(['mode', 'days', 'startTime', 'endTime'])
        && preferences.mode in ['light', 'moderate', 'hard']
        && preferences.days is list
        && preferences.days.size() >= 1
        && preferences.days.size() <= 7
        && preferences.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && preferences.startTime is string
        && preferences.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && preferences.endTime is string
        && preferences.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && preferences.endTime > preferences.startTime;
    }

    function hasValidLegacyIdentity(profile) {
      let identityFields = ['age', 'birthplaceCity', 'birthplaceState', 'identityConsentAt'];
      return profile.keys().hasAll(identityFields)
        && profile.age is int
        && profile.age >= 14
        && profile.age <= 100
        && profile.birthplaceCity is string
        && profile.birthplaceCity.size() >= 2
        && profile.birthplaceCity.size() <= 80
        && profile.birthplaceState is string
        && profile.birthplaceState.size() >= 2
        && profile.birthplaceState.size() <= 80
        && profile.identityConsentAt is timestamp
        && (!profile.keys().hasAny(['sex']) || profile.sex in ['feminino', 'masculino']);
    }

    function hasValidNewIdentity(profile) {
      return profile.keys().hasAll(['birthDate', 'whatsapp', 'currentCity'])
        && profile.birthDate is string
        && profile.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && profile.whatsapp is string
        && profile.whatsapp.matches('^[0-9]{10,13}$')
        && profile.currentCity is string
        && profile.currentCity.size() >= 2
        && profile.currentCity.size() <= 80;
    }

    function hasValidIdentity(profile) {
      let legacyFields = ['age', 'sex', 'birthplaceCity', 'birthplaceState', 'identityConsentAt'];
      let newFields = ['birthDate', 'whatsapp', 'currentCity'];
      return (!profile.keys().hasAny(legacyFields) && !profile.keys().hasAny(newFields))
        || (profile.keys().hasAny(newFields) && !profile.keys().hasAny(['age', 'sex', 'birthplaceCity', 'birthplaceState']) && hasValidNewIdentity(profile))
        || (!profile.keys().hasAny(newFields) && hasValidLegacyIdentity(profile));
    }

    function hasValidProfile() {
      let profile = request.resource.data;
      return profile.keys().hasAll(['displayName', 'email', 'updatedAt'])
        && profile.keys().hasOnly([
          'displayName', 'email', 'studyPreferences', 'updatedAt',
          'age', 'sex', 'birthplaceCity', 'birthplaceState', 'identityConsentAt',
          'birthDate', 'whatsapp', 'currentCity'
        ])
        && profile.displayName is string
        && profile.displayName.size() > 0
        && profile.displayName.size() <= 80
        && profile.email is string
        && profile.email == request.auth.token.email
        && hasValidIdentity(profile)
        && (!profile.keys().hasAny(['studyPreferences']) || hasValidStudyPreferences(profile))
        && profile.updatedAt == request.time;
    }

    function hasAccess() {
      return exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true;
    }

    function isValidSyncDoc(syncId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['key', 'value', 'deleted', 't'])
        && data.keys().hasAll(['key', 'deleted', 't'])
        && data.key is string
        && data.key == syncId
        && data.key.matches('^pmpe[A-Za-z0-9_]{0,100}$')
        && data.deleted is bool
        && data.t is number
        && (!data.keys().hasAny(['value']) || data.value == null || (data.value is string && data.value.size() <= 900000));
    }

    function isValidTicket() {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'email', 'name', 'type', 'subject', 'message', 'protocol', 'status', 'createdAt'])
        && data.keys().hasAll(['uid', 'email', 'name', 'type', 'subject', 'message', 'protocol', 'status', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.name is string && data.name.size() <= 80
        && data.type in ['duvida', 'suporte', 'sugestao', 'reclamacao', 'elogio', 'denuncia']
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 3000
        && data.protocol is string && data.protocol.size() >= 8 && data.protocol.size() <= 32
        && data.status == 'open'
        && data.createdAt == request.time;
    }

    function isValidTicketReview() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt'])
        && data.status in ['open', 'answered', 'closed']
        && (!data.keys().hasAny(['reply']) || (data.reply is string && data.reply.size() <= 3000));
    }

    function isValidFeedback() {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'email', 'name', 'rating', 'category', 'liked', 'improve', 'createdAt'])
        && data.keys().hasAll(['uid', 'email', 'name', 'rating', 'category', 'liked', 'improve', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.name is string && data.name.size() <= 80
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.category in ['geral', 'conteudo', 'videoaulas', 'flashcards', 'mapas', 'simulados', 'interface', 'desempenho']
        && data.liked is string && data.liked.size() <= 1500
        && data.improve is string && data.improve.size() <= 1500
        && (data.liked.size() > 0 || data.improve.size() > 0)
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create, update: if isOwner(userId) && hasValidProfile();
      allow delete: if false;

      match /sync/{syncId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSyncDoc(syncId);
        allow delete: if isOwner(userId);
      }
    }

    match /tickets/{ticketId} {
      allow get: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && hasAccess() && isValidTicket();
      allow update: if isAdmin() && isValidTicketReview();
      allow delete: if false;
    }

    match /feedbacks/{feedbackId} {
      allow get: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && hasAccess() && isValidFeedback();
      allow update, delete: if false;
    }

    match /access/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /accessRequests/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && !exists(/databases/$(database)/documents/accessRequests/$(userId))
        && hasValidAccessRequest();
      allow update: if (isOwner(userId) && (isValidResubmission() || isValidPromoApplication()))
        || (isAdmin() && isValidAdminReview());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
